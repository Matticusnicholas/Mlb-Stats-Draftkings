{
  "manifest_version": 2,
  "name": "Underdog Fantasy Draft Sounds",
  "version": "1.0.0",
  "description": "Adds sound notifications to Underdog Fantasy drafts - alerts for picks, your turn, and lobby changes",
  "author": "Fantasy Draft Tools",
  "homepage_url": "https://github.com/Matticusnicholas/underdog-draft-sounds",

  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },

  "permissions": [
    "storage",
    "notifications"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://underdogfantasy.com/*",
        "*://www.underdogfantasy.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "browser_action": {
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    },
    "default_title": "Underdog Draft Sounds",
    "default_popup": "popup/popup.html"
  },

  "web_accessible_resources": [
    "sounds/*.mp3",
    "sounds/*.wav"
  ]
}
